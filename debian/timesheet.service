[Unit]
Description=Timesheet
After=network.target

[Service]
Type=simple
User=timesheet
Group=timesheet
StateDirectory=timesheet
StateDirectoryMode=0700
WorkingDirectory=/var/lib/timesheet
ExecStart=/usr/bin/timesheet run --config=/etc/timesheet/timesheet.json
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

